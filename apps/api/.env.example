# --- Core ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/zetapanel

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Render API (https://api-docs.render.com) ---
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RENDER_API_BASE_URL=https://api.render.com/v1

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=zetapanel-storage

# --- ZIP-upload deploy bridge (deploymentSource: "r2_zip") ---
# Git URL containing apps/runtime/Dockerfile — normally this same ZetaPanel
# repo. Required only if you want to offer "upload a ZIP and run it"
# instead of requiring users to bring their own Git repo.
ZETAPANEL_RUNTIME_REPO=https://github.com/your-org/zetapanel
ZETAPANEL_RUNTIME_BRANCH=main

LOG_LEVEL=info
